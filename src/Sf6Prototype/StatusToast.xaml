<UserControl x:Class="Sf6Prototype.StatusToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" MinWidth="240" MaxWidth="560"
             AutomationProperties.LiveSetting="Polite">
  <Border x:Name="Surface" Background="{DynamicResource WinSoft}" BorderBrush="{DynamicResource Line}"
          BorderThickness="1" CornerRadius="10" Padding="16,12">
    <Border.Effect><DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="20" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="MessageButton" Click="Dismiss_Click" Padding="0" Background="Transparent" BorderThickness="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
          </ControlTemplate></Button.Template>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ink}"/>
        </Button>
        <Button x:Name="ActionButton" Grid.Column="1" Margin="14,0,0,0" Padding="10,4"
                Click="Action_Click" Visibility="Collapsed"/>
      </Grid>
      <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="1"
                   Foreground="{DynamicResource Win}" Background="{DynamicResource LineSubtle}"
                   BorderThickness="0" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</UserControl>
