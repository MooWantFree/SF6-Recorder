<Window x:Class="Sf6Prototype.CloseChoiceWindow" Language="{DynamicResource UiLanguage}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource I18n.CloseWindow}" Icon="{StaticResource AppIcon}" Width="410" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="24,20">
    <TextBlock Text="{DynamicResource I18n.CloseWindowQuestion}" FontSize="16" FontWeight="SemiBold"/>
    <CheckBox x:Name="RememberChoice" Content="{DynamicResource I18n.RememberChoice}" Margin="0,20,0,22"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource I18n.Cancel}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource I18n.Exit}" Click="Exit_Click" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource I18n.MinimizeToTray}" Click="Minimize_Click" Style="{StaticResource AccentButton}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
