<local:ChromeWindow x:Class="Sf6Prototype.OverlayCaptureNotice" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sf6Prototype"
        Resources="{StaticResource StreamPalette}" Title="{DynamicResource I18n.OverlayCaptureTitle}"
        Language="{DynamicResource UiLanguage}" FontFamily="{DynamicResource UiFont}" FontSize="13"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        Width="410" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="WindowSurface" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineSubtle}"
          BorderThickness="1" CornerRadius="8">
    <StackPanel Margin="16,0,16,14">
      <Grid x:Name="TitleBar" Height="46">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16"
                   Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="{DynamicResource I18n.OverlayCaptureSource}" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Text="{DynamicResource I18n.OverlayCaptureOpacityTip}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/>
      <Button Content="{DynamicResource I18n.GotIt}" Click="Acknowledge_Click" IsDefault="True"
              HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="90" FontWeight="SemiBold"
              Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource Surface}"/>
    </StackPanel>
  </Border>
</local:ChromeWindow>
