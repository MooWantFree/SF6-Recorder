<Window x:Class="Sf6Prototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sf6Prototype"
        Title="街霸 6 战绩" Width="1380" Height="880" MinWidth="1120" MinHeight="720"
        FontFamily="Microsoft YaHei UI" FontSize="12.5" Foreground="#28282D" Background="#F5F5F7" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="MatchItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="White" BorderBrush="#E8E8ED" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F9F9FC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CharacterItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EDEDF3"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="White"/><Setter TargetName="Tile" Property="BorderBrush" Value="#7878D4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F5F5F7">
    <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#F0F0F3" BorderBrush="#DFDFE4" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,18,10,10">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="10,0,0,23"><TextBlock Text="SF6" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="战绩档案" FontSize="12" Foreground="#777780" VerticalAlignment="Center" Margin="8,2,0,0"/></StackPanel>
          <ListBox x:Name="Navigation" SelectionChanged="Navigation_Changed" SelectedIndex="0" Style="{StaticResource NavList}">
            <ListBoxItem AutomationProperties.Name="战绩总览"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="战绩总览"/></StackPanel></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="角色分数"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="角色分数"/></StackPanel></ListBoxItem>
            <ListBoxItem AutomationProperties.Name="连接设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="连接设置"/></StackPanel></ListBoxItem>
          </ListBox>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock x:Name="ArchiveCount" Text="0 条战绩" Foreground="#777780" FontSize="11" Margin="10,0,0,8"/>
          <Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,0,12" Padding="8,6" Background="Transparent" BorderThickness="0" Foreground="#66666F"/>
          <Border BorderBrush="#DCDCE3" BorderThickness="0,1,0,0" Padding="0,9,0,0">
            <Button x:Name="LoginButton" Click="Account_Click" Background="Transparent" BorderThickness="0" Padding="5,5" Margin="0" AutomationProperties.Name="账号菜单">
              <Grid Width="140"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                <Grid Width="30" Height="30"><Ellipse Fill="#DADAE4"/><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777780"/><Ellipse x:Name="AccountAvatar"/></Grid>
                <TextBlock x:Name="AccountName" Grid.Column="1" Text="登录" VerticalAlignment="Center" Margin="7,0,4,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" VerticalAlignment="Center" Foreground="#777780"/>
              </Grid>
            </Button>
          </Border>
          <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=LoginButton}" Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#DCDCE4" BorderThickness="1" CornerRadius="6" Width="290" Padding="7">
              <StackPanel>
                <TextBlock Text="账号" Foreground="#888892" FontSize="11" Margin="8,5,0,9"/>
                <ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border x:Name="AccountRow" CornerRadius="4" Background="Transparent" Padding="3" Margin="0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                      <Button Tag="{Binding Id}" Click="SwitchAccount_Click" BorderThickness="0" Background="Transparent" Margin="0" Padding="5,7" HorizontalContentAlignment="Stretch">
                        <Grid Width="207"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                          <Grid Width="28" Height="28"><Ellipse Fill="#E4E4EC"/><Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="ActiveMark" Grid.Column="2" Text="✓" Foreground="#5B5BD6" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                      </Button>
                      <Button x:Name="Logout" Grid.Column="1" Tag="{Binding Id}" Content="×" FontSize="18" ToolTip="登出" AutomationProperties.Name="登出账号" Click="Logout_Click" BorderThickness="0" Background="Transparent" Padding="0" Margin="0" Opacity="0"/>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="AccountRow" Property="IsMouseOver" Value="True"><Setter TargetName="AccountRow" Property="Background" Value="#F4F4F8"/><Setter TargetName="Logout" Property="Opacity" Value="1"/></Trigger>
                    <Trigger SourceName="AccountRow" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Logout" Property="Opacity" Value="1"/></Trigger>
                    <DataTrigger Binding="{Binding Active}" Value="True"><Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border BorderBrush="#EBEBEF" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,5,0,0"><Button Content="＋  添加 / 重新登录账号" Click="Login_Click" Background="Transparent" BorderThickness="0" Margin="0"/></Border>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="20,18,20,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="UpdatedLabel" Foreground="#777780" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="SyncButton" Content="刷新" Click="Sync_Click" Background="#5B5BD6" Foreground="White" Margin="0"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel>
        <StackPanel><TextBlock x:Name="PageTitle" Text="战绩总览" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AccountLabel" Visibility="Collapsed"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid x:Name="HistoryView">
          <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
          <Border BorderBrush="#E1E1E6" BorderThickness="0,1,0,1" Background="#FAFAFB" Padding="14,10" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="场次" Foreground="#777780" VerticalAlignment="Center"/><TextBlock x:Name="TotalMetric" Text="0" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="胜率" Foreground="#777780" VerticalAlignment="Center"/><TextBlock x:Name="WinRateMetric" Text="—" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0"/></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="胜 / 负 / 平" Foreground="#777780" VerticalAlignment="Center"/><TextBlock x:Name="ResultsMetric" Text="0 / 0 / 0" FontSize="15" FontWeight="Medium" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
              <TextBlock x:Name="RangeMetric" Grid.Column="3" Text="尚无记录" Foreground="#777780" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <WrapPanel Grid.Row="1" Margin="0,0,0,4">
            <StackPanel Margin="0,0,10,10"><TextBlock Text="分类" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="CategoryFilter" Width="130" SelectionChanged="Filter_Changed" AutomationProperties.Name="分类筛选"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="角色" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="CharacterFilter" Width="110" SelectionChanged="Filter_Changed" AutomationProperties.Name="角色筛选"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="结果" Style="{StaticResource FilterLabel}"/><ComboBox x:Name="OutcomeFilter" Width="90" SelectionChanged="Filter_Changed" AutomationProperties.Name="结果筛选"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="日期" Style="{StaticResource FilterLabel}"/><local:DateRangePicker x:Name="DateRange" Width="190" RangeChanged="Date_Changed"/></StackPanel>
            <StackPanel Margin="0,0,10,10"><TextBlock Text="对手 / 回放 ID" Style="{StaticResource FilterLabel}"/><TextBox x:Name="SearchBox" Width="166" ToolTip="Ctrl+F" TextChanged="Search_Changed" AutomationProperties.Name="搜索战绩"/></StackPanel>
            <Button Content="重置" Click="Reset_Click" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
              <ListBox x:Name="MatchesGrid" BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource MatchItem}" MouseDoubleClick="Match_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="战绩列表">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid Height="94" Margin="14,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="76"/><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" Height="52" Background="{Binding ResultColor}" CornerRadius="1"/>
                    <Image Grid.Column="1" Source="{Binding OwnImage}" Width="65" Height="65" Stretch="UniformToFill"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="7,0,8,0"><TextBlock Text="{Binding Battle.PlayerName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OwnPoints}" Foreground="#7B7B86" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Battle.Score}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0,7,0"><TextBlock Text="{Binding Battle.Opponent}" FontWeight="SemiBold" FontSize="14" TextAlignment="Right" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OpponentPoints}" Foreground="#7B7B86" FontSize="11" Margin="0,5,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Image Grid.Column="5" Source="{Binding OpponentImage}" Width="65" Height="65" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform></Image>
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Meta}" FontSize="10" Foreground="#92929D" VerticalAlignment="Bottom" Margin="7,0,0,5"/>
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="{Binding Battle.ReplayId}" FontSize="10" Foreground="#92929D" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,7,5"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyHint" Text="暂无战绩，点击「刷新」开始保存。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777780" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click" Padding="10,4"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="10,0,16,0"/><Button x:Name="NextButton" Content="下一页" Click="Next_Click" Padding="10,4" Margin="0"/></StackPanel></DockPanel>
        </Grid>
        <Grid x:Name="ScoresView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <ListBox x:Name="CharacterGrid" SelectionChanged="ScoreCharacter_Changed" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CharacterItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="角色选择">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Width="70"><Image Source="{Binding Image}" Height="56" Width="56" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="1" Margin="0,10,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox x:Name="ScoreCount" Width="110" SelectedIndex="0" SelectionChanged="Metric_Changed" Margin="0,0,8,0" AutomationProperties.Name="分数记录数量"><ComboBoxItem Content="最近 20 条" Tag="20"/><ComboBoxItem Content="最近 50 条" Tag="50"/><ComboBoxItem Content="最近 100 条" Tag="100"/><ComboBoxItem Content="全部记录" Tag="0"/></ComboBox><ComboBox x:Name="ScoreMetric" Width="76" SelectedIndex="0" SelectionChanged="Metric_Changed"><ComboBoxItem Content="LP"/><ComboBoxItem Content="MR"/></ComboBox></StackPanel>
            <StackPanel><TextBlock x:Name="ScoreTitle" Text="角色分数" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CharacterStats" Foreground="#777780" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><local:ScoreChart x:Name="Chart" AutomationProperties.Name="角色分数点线图"/></Border>
          <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0"><DataGrid x:Name="ScoreGrid"><DataGrid.Columns><DataGridTextColumn Header="时间 (UTC+8)" Binding="{Binding Time}" Width="*"/><DataGridTextColumn Header="LP" Binding="{Binding Lp}" Width="110"/><DataGridTextColumn Header="LP 差值" Binding="{Binding LpChange}" Width="110"/><DataGridTextColumn Header="MR" Binding="{Binding MrText}" Width="110"/><DataGridTextColumn Header="MR 差值" Binding="{Binding MrChange}" Width="110"/><DataGridTextColumn Header="回放 ID" Binding="{Binding ReplayId}" Width="140"/></DataGrid.Columns></DataGrid></Border>
        </Grid>
        <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SettingsPanel" MaxWidth="850" HorizontalAlignment="Left" MinWidth="680">
            <TextBlock Text="网络" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid Margin="14,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="使用代理" VerticalAlignment="Center"/><CheckBox x:Name="ProxyEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="使用代理"/></Grid>
              <Border BorderBrush="#E8E8EC" BorderThickness="0,1,0,0" Margin="14,0"><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="代理地址" VerticalAlignment="Center"/><TextBox x:Name="ProxyAddressBox" Grid.Column="1" MinWidth="350"/></Grid></Border>
              <Border BorderBrush="#E8E8EC" BorderThickness="0,1,0,0" Margin="14,0"><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Google 连通性" VerticalAlignment="Center"/><TextBlock x:Name="ProxyTestResult" Grid.Column="1" VerticalAlignment="Center" Foreground="#777780" TextWrapping="Wrap" Margin="0,0,12,0"/><Button x:Name="TestProxyButton" Grid.Column="2" Content="测试延迟" Click="TestProxy_Click" Margin="0"/></Grid></Border>
            </StackPanel></Border>
            <Button Content="保存设置" Click="SaveSettings_Click" Background="#5B5BD6" Foreground="White" HorizontalAlignment="Right" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,10,0,0"><ProgressBar x:Name="SyncProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="就绪" Foreground="#777780" FontSize="11" TextWrapping="Wrap"/></StackPanel>
    </Grid>
  </Grid>
</Window>

