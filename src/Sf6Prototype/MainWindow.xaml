<Window x:Class="Sf6Prototype.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sf6Prototype" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="街霸 6 战绩" Icon="{StaticResource AppIcon}" Width="1380" Height="880" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="{StaticResource Ink}" Background="{StaticResource Canvas}" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="56" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid x:Name="HeaderToolbar" Margin="24,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel x:Name="NavigationBar" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="Back_Click" IsEnabled="False" ToolTip="后退 · Alt+←&#x0a;右键查看历史" AutomationProperties.Name="后退" ContextMenuOpening="NavigationMenu_Opening">
              <Button.ContextMenu><ContextMenu Style="{StaticResource NavigationMenu}"/></Button.ContextMenu>
            </Button>
            <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="Forward_Click" IsEnabled="False" ToolTip="前进 · Alt+→&#x0a;右键查看历史" AutomationProperties.Name="前进" ContextMenuOpening="NavigationMenu_Opening">
              <Button.ContextMenu><ContextMenu Style="{StaticResource NavigationMenu}"/></Button.ContextMenu>
            </Button>
            <Button x:Name="SyncButton" Style="{StaticResource NavigationRefreshButton}" Click="Sync_Click" ToolTip="刷新 · Ctrl+R" AutomationProperties.Name="刷新">
              <Grid><TextBlock x:Name="SyncIcon" Style="{StaticResource RefreshReminderIcon}" Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/><local:RefreshProgressGlyph x:Name="SyncRing" Visibility="Collapsed"/></Grid>
            </Button>
            <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;" Click="Home_Click" IsEnabled="False" ToolTip="主页 · 我的战绩" AutomationProperties.Name="主页"/>
            <Button x:Name="CancelButton" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Cancel_Click" Visibility="Collapsed" ToolTip="取消刷新" AutomationProperties.Name="取消刷新"/>
          </StackPanel>
          <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="12,0"/>
          <ListBox x:Name="PageTabs" Style="{StaticResource Segmented}" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="PageTabs_Changed" AutomationProperties.Name="页面">
            <ListBoxItem Content="战绩"/><ListBoxItem Content="分数"/>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="16,0" MaxWidth="360" VerticalAlignment="Center">
          <TextBlock x:Name="ViewedPlayerName" Text="我的战绩" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2" AutomationProperties.Name="当前查看玩家"/>
          <TextBlock x:Name="UpdatedLabel" FontSize="11" Foreground="{StaticResource Ink3}" Height="16" TextAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid Margin="0,0,12,0" VerticalAlignment="Center">
            <Border x:Name="PlayerSearchField" Width="200" Height="34" BorderThickness="1" CornerRadius="5" LostKeyboardFocus="PlayerSearch_LostKeyboardFocus">
              <Border.Style><Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPlayerSearchActive,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
              </Style></Border.Style>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="FindPlayerButton" Style="{StaticResource IconButton}" Width="28" Height="30" FontSize="13" Content="&#xE77B;" Click="FindPlayer_Click" ToolTip="查找玩家 · Ctrl+K" AutomationProperties.Name="激活玩家搜索"/>
                <Grid Grid.Column="1">
                  <TextBox x:Name="PlayerUidBox" MaxLength="32" KeyDown="PlayerUid_KeyDown" TextChanged="PlayerUid_Changed" GotKeyboardFocus="PlayerUid_Focused" BorderThickness="0" Background="Transparent" Padding="2,0" MinHeight="0" VerticalContentAlignment="Center" AutomationProperties.Name="玩家 UID，按回车查询"/>
                  <TextBlock Text="输入玩家 UID" Foreground="{StaticResource Ink3}" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=PlayerUidBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Button x:Name="ClearPlayerUidButton" Grid.Column="2" Width="24" Height="28" MinHeight="0" FontSize="10" Content="&#xE711;" Click="ClearPlayerUid_Click" ToolTip="清空" AutomationProperties.Name="清空玩家 UID">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlayerSearchActive,RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding Text,ElementName=PlayerUidBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="PlayerSearchSubmit" Grid.Column="3" Content="搜索" Style="{StaticResource GhostButton}" Padding="8,0" MinHeight="28" Margin="0,2,2,2" Click="PlayerSearchSubmit_Click" Visibility="{Binding IsPlayerSearchActive,RelativeSource={RelativeSource AncestorType={x:Type Window}},Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="搜索玩家"/>
              </Grid>
            </Border>
            <Popup x:Name="PlayerSearchPopup" PlacementTarget="{Binding ElementName=PlayerSearchField}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="4" StaysOpen="True" AllowsTransparency="True">
              <ContentControl Style="{StaticResource PopupSurface}" Margin="0" Width="{Binding ActualWidth,ElementName=PlayerSearchField}" Padding="8">
                <StackPanel>
                  <TextBlock x:Name="PlayerSearchStatus" Text="查询中…" Foreground="{StaticResource Ink2}" Margin="4,4" Visibility="Collapsed"/>
                  <TextBlock x:Name="PlayerSearchError" Foreground="{StaticResource Loss}" TextWrapping="Wrap" Margin="4,4" Visibility="Collapsed"/>
                  <TextBlock x:Name="PlayerSearchEmpty" Text="暂无查询记录" Style="{StaticResource Caption}" Margin="4,6" Visibility="Collapsed"/>
                  <TextBlock x:Name="PlayerSearchHistoryLabel" Text="最近查询" Style="{StaticResource Caption}" Margin="4,4,0,4"/>
                  <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PlayerSearchHistoryList"><ItemsControl.ItemTemplate><DataTemplate>
                      <Button Tag="{Binding}" Click="PlayerHistory_Click" Style="{StaticResource GhostButton}" Padding="8,7" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding DisplayName}">
                        <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </ContentControl>
            </Popup>
          </Grid>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="设置 · Ctrl+," AutomationProperties.Name="设置"/>
          <Button x:Name="AccountButton" Style="{StaticResource GhostButton}" Click="Account_Click" Padding="6,4" Margin="4,0,0,0" AutomationProperties.Name="账号">
            <StackPanel Orientation="Horizontal">
              <Grid Width="28" Height="28"><Ellipse Fill="{StaticResource AvatarPlaceholder}"/><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink3}"/><Ellipse x:Name="AccountAvatar"/></Grid>
              <TextBlock x:Name="AccountName" Text="登录" MaxWidth="90" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,6,0"/>
              <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="9" VerticalAlignment="Center" Foreground="{StaticResource Ink3}"/>
            </StackPanel>
          </Button>
          <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}" Placement="Bottom" VerticalOffset="-2" StaysOpen="False" AllowsTransparency="True">
            <ContentControl Style="{StaticResource PopupSurface}" Width="290" Padding="6">
              <StackPanel>
                <ItemsControl x:Name="AccountsList"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border x:Name="AccountRow" CornerRadius="4" Background="Transparent" Margin="0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                      <Button Tag="{Binding Id}" Click="SwitchAccount_Click" Style="{StaticResource GhostButton}" Padding="8,7" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                          <Grid Width="28" Height="28"><Ellipse Fill="{StaticResource AvatarPlaceholder}"/><Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="ActiveMark" Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                      </Button>
                      <Button x:Name="Logout" Grid.Column="1" Tag="{Binding Id}" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" ToolTip="登出" AutomationProperties.Name="登出账号" Click="Logout_Click" Opacity="0"/>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="AccountRow" Property="IsMouseOver" Value="True"><Setter TargetName="AccountRow" Property="Background" Value="{StaticResource SurfaceHover}"/><Setter TargetName="Logout" Property="Opacity" Value="1"/></Trigger>
                    <Trigger SourceName="AccountRow" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Logout" Property="Opacity" Value="1"/></Trigger>
                    <DataTrigger Binding="{Binding Active}" Value="True"><Setter TargetName="ActiveMark" Property="Visibility" Value="Visible"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                  <Button Click="Login_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,7">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="添加或重新登录账号"/></StackPanel>
                  </Button>
                </Border>
              </StackPanel>
            </ContentControl>
          </Popup>
        </StackPanel>
      </Grid>
      <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"/>
      </StackPanel>
    </Grid>

    <Border x:Name="NoticeBar" Grid.Row="1" MaxWidth="1480" Margin="24,12,24,0" CornerRadius="6" Padding="14,6,6,6" Background="{StaticResource InfoSoft}" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" Click="DismissNotice_Click" AutomationProperties.Name="关闭提示"/>
        <Button x:Name="NoticeAction" DockPanel.Dock="Right" Margin="0,0,6,0" Padding="10,3" MinHeight="26" Click="NoticeAction_Click" Visibility="Collapsed"/>
        <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="24,14,24,20" MaxWidth="1480">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <local:HistoryView x:Name="History"/>
      <local:ScoresView x:Name="Scores" Visibility="Collapsed"/>
      <local:MatchDetailPanel x:Name="Detail" Grid.Column="1" Margin="16,0,0,0"/>
    </Grid>
  </Grid>
</Window>
