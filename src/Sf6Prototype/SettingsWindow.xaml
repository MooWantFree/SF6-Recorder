<Window x:Class="Sf6Prototype.SettingsWindow" Language="{DynamicResource UiLanguage}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource I18n.Settings}" Icon="{StaticResource AppIcon}" Width="740" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
  <Border Background="{StaticResource Canvas}" Padding="24,20">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource I18n.LanguageLabel}" VerticalAlignment="Center"/>
        <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.LanguageLabel}">
          <ComboBoxItem Content="{DynamicResource I18n.SystemDefault}" Tag="system"/>
          <ComboBoxItem Content="English" Tag="en"/>
          <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
          <ComboBoxItem Content="繁體中文" Tag="zh-Hant"/>
          <ComboBoxItem Content="日本語" Tag="ja"/>
        </ComboBox>
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <Grid Margin="16,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource I18n.UseProxy}" VerticalAlignment="Center"/>
          <CheckBox x:Name="ProxyEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.UseProxy}"/>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource I18n.ProxyAddress}" VerticalAlignment="Center"/>
            <TextBox x:Name="ProxyAddressBox" Grid.Column="1" IsEnabled="{Binding IsChecked,ElementName=ProxyEnabled}" ToolTip="{DynamicResource I18n.ProxyHelp}" AutomationProperties.Name="{DynamicResource I18n.ProxyAddress}"/>
          </Grid>
        </Border>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource I18n.GoogleLatency}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TestResult" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button x:Name="TestButton" Grid.Column="2" Content="{DynamicResource I18n.Test}" Click="Test_Click"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Margin="16,12">
          <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource I18n.ApiInterval}" VerticalAlignment="Center"/>
            <TextBox x:Name="ApiIntervalBox" Grid.Column="1" TextChanged="ApiInterval_Changed" MaxLength="8" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.ApiIntervalAccessible}" ToolTip="{DynamicResource I18n.ApiIntervalHelp}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
            <ListBox x:Name="ApiIntervalPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ApiIntervalPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.ApiIntervalPresets}">
              <ListBoxItem Content="{DynamicResource I18n.OneSecond}" Tag="1" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.ThreeSeconds}" Tag="3" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.FiveSeconds}" Tag="5" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TenSeconds}" Tag="10" Width="70" Padding="4,4"/>
            </ListBox>
          </Grid>
          <TextBlock x:Name="ApiIntervalWarning" Text="{DynamicResource I18n.ShortIntervalWarning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="180,6,0,0" FontSize="12" Visibility="Collapsed"/>
        </StackPanel>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0"/>
        <Grid Margin="16,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource I18n.RefreshReminder}" VerticalAlignment="Center"/>
          <TextBox x:Name="ReminderSecondsBox" Grid.Column="1" TextChanged="ReminderSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="{DynamicResource I18n.ReminderOffHelp}" AutomationProperties.Name="{DynamicResource I18n.ReminderAccessible}"/>
          <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
          <ListBox x:Name="ReminderPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ReminderPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.ReminderPresets}">
            <ListBoxItem Content="{DynamicResource I18n.Off}" Tag="0" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneDay}" Tag="86400" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TwelveHours}" Tag="43200" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneHour}" Tag="3600" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TenMinutes}" Tag="600" Width="56" Padding="4,4"/>
          </ListBox>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource I18n.AutoRefresh}" VerticalAlignment="Center"/>
            <TextBox x:Name="AutoRefreshSecondsBox" Grid.Column="1" TextChanged="AutoRefreshSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="{DynamicResource I18n.AutoRefreshHelp}" AutomationProperties.Name="{DynamicResource I18n.AutoRefreshAccessible}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
            <ListBox x:Name="AutoRefreshPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="AutoRefreshPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.AutoRefreshPresets}">
              <ListBoxItem Content="{DynamicResource I18n.Off}" Tag="0" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.FiveMinutes}" Tag="300" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TwentyMinutes}" Tag="1200" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneHour}" Tag="3600" Width="70" Padding="4,4"/>
            </ListBox>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource I18n.WhenWindowCloses}" VerticalAlignment="Center"/>
          <ComboBox x:Name="CloseActionBox" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="{DynamicResource I18n.WhenWindowCloses}">
            <ComboBoxItem Content="{DynamicResource I18n.AskEveryTime}"/><ComboBoxItem Content="{DynamicResource I18n.MinimizeToTray}"/><ComboBoxItem Content="{DynamicResource I18n.Exit}"/>
          </ComboBox>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource I18n.Database}" VerticalAlignment="Center"/>
            <TextBlock x:Name="DatabaseStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ImportButton" Content="{DynamicResource I18n.Import}" Click="Import_Click" Margin="0,0,8,0" ToolTip="{DynamicResource I18n.ImportHelp}"/>
              <Button x:Name="BackupButton" Content="{DynamicResource I18n.BackupDatabase}" Click="Backup_Click" ToolTip="{DynamicResource I18n.BackupHelp}"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Loss}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{DynamicResource I18n.Cancel}" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
      <Button x:Name="SaveButton" Content="{DynamicResource I18n.Save}" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="76"/>
    </StackPanel>
  </StackPanel>
  </Border>
</Window>
