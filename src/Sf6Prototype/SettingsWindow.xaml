<local:ChromeWindow x:Class="Sf6Prototype.SettingsWindow" Language="{DynamicResource UiLanguage}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sf6Prototype" xmlns:core="clr-namespace:Sf6Prototype;assembly=Sf6Prototype.Core" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource I18n.Settings}" Icon="{StaticResource AppIcon}" Width="740" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="56" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SettingsTitle" Text="{DynamicResource I18n.Settings}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,16,0"/>
      <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" Margin="8,0,6,0" VerticalAlignment="Center" ToolTip="{DynamicResource I18n.Close}" AutomationProperties.Name="{DynamicResource I18n.Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
  <Border Grid.Row="1" Background="{StaticResource Canvas}" Padding="24,4,24,20">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <local:UpdateNotice x:Name="AvailableUpdateNotice" Margin="0,0,0,12" IsEnabled="{Binding IsEnabled,ElementName=InstallUpdateButton}"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ListBox x:Name="CategoryNav" Style="{StaticResource NavList}" VerticalAlignment="Top" SelectionChanged="Category_Changed" AutomationProperties.Name="{DynamicResource I18n.SettingsCategories}">
        <ListBoxItem Content="{DynamicResource I18n.SettingsGeneral}" Tag="GeneralPage"/>
        <ListBoxItem Content="{DynamicResource I18n.SettingsNetwork}" Tag="NetworkPage"/>
        <ListBoxItem Content="{DynamicResource I18n.SettingsRefresh}" Tag="RefreshPage"/>
        <ListBoxItem Content="{DynamicResource I18n.StreamWindow}" Tag="OverlayPage"/>
        <ListBoxItem Content="{DynamicResource I18n.SettingsData}" Tag="DataPage"/>
        <ListBoxItem Content="{DynamicResource I18n.SettingsAbout}" Tag="AboutPage"/>
      </ListBox>
      <!-- Inactive pages stay Hidden, not Collapsed, so the window keeps one height while switching. -->
      <Grid x:Name="Pages" Grid.Column="2">

        <StackPanel x:Name="GeneralPage">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.LanguageLabel}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.LanguageLabel}">
                  <ComboBoxItem Content="{DynamicResource I18n.SystemDefault}" Tag="system"/>
                  <ComboBoxItem Content="English" Tag="en"/>
                  <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                  <ComboBoxItem Content="繁體中文" Tag="zh-Hant"/>
                  <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>
              </Grid>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.WhenWindowCloses}" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CloseActionBox" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="{DynamicResource I18n.WhenWindowCloses}">
                    <ComboBoxItem Content="{DynamicResource I18n.AskEveryTime}"/><ComboBoxItem Content="{DynamicResource I18n.MinimizeToTray}"/><ComboBoxItem Content="{DynamicResource I18n.Exit}"/>
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource I18n.QuickLaunch}" VerticalAlignment="Center"/>
                  <Border x:Name="QuickLaunchHelp" Margin="4,0,0,0" Padding="3" Background="Transparent" Cursor="Help"
                          Focusable="True" ToolTipService.ShowsToolTipOnKeyboardFocus="True" ToolTipService.InitialShowDelay="200"
                          ToolTip="{DynamicResource I18n.QuickLaunchHint}" AutomationProperties.Name="{DynamicResource I18n.QuickLaunchHint}">
                    <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ink3}">
                      <TextBlock Text="?" FontSize="11" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Border>
                </StackPanel>
                <ListBox x:Name="LaunchTargetBox" Grid.Column="1" Style="{StaticResource Segmented}" HorizontalAlignment="Left"
                         SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.QuickLaunch}">
                  <ListBoxItem Tag="Game" Content="{DynamicResource I18n.QuickLaunchGameName}"/>
                  <ListBoxItem Tag="Accelerator" Content="{DynamicResource I18n.QuickLaunchAcceleratorName}"/>
                  <ListBoxItem Tag="Off" Content="{DynamicResource I18n.QuickLaunchOff}"/>
                </ListBox>
              </Grid>
              <Border x:Name="LaunchFilePanel" BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0"
                      Margin="0,12,0,0" Padding="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.QuickLaunchProgramPath}" VerticalAlignment="Top"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LaunchFileLabel" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink2}"
                               AutomationProperties.Name="{Binding ToolTip,RelativeSource={RelativeSource Self},TargetNullValue=''}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Click="ChooseLaunchFile_Click" Content="{DynamicResource I18n.QuickLaunchBrowse}"/>
                      <Button x:Name="FindGameButton" Click="FindGame_Click" Content="{DynamicResource I18n.QuickLaunchDetect}"
                              Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentText}" Margin="6,0,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="OverlayPage" Visibility="Hidden">
          <DockPanel Margin="0,0,0,4">
            <Button x:Name="PreviewOnStream" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" MinHeight="24"
                    Padding="8,2" Foreground="{StaticResource AccentText}" Content="{DynamicResource I18n.OverlayPreviewOnStream}"
                    Click="ToggleStreamPreview"/>
            <TextBlock Text="{DynamicResource I18n.OverlaySamplePreview}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Background="{StaticResource OverlayPreviewGrid}" CornerRadius="6" Padding="6" Margin="0,0,0,10">
            <Viewbox Stretch="Uniform" Height="84" IsHitTestVisible="False">
              <local:OverlayMatchCard x:Name="SampleCard" Width="560" Height="80"/>
            </Viewbox>
          </Border>

          <Border Style="{StaticResource Card}" Padding="14,10">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <Button x:Name="ResetStyleButton" DockPanel.Dock="Right" Content="{DynamicResource I18n.OverlayResetStyle}" Click="ResetOverlayStyle"/>
                <ListBox x:Name="OverlaySections" Style="{StaticResource Segmented}" SelectedIndex="0" AutomationProperties.Name="{DynamicResource I18n.OverlayStyleSettings}">
                  <ListBoxItem x:Name="MetricsTab" Content="{DynamicResource I18n.OverlayMetricsTab}"/>
                  <ListBoxItem x:Name="TrendTab" Content="{DynamicResource I18n.OverlayTrend}"/>
                  <ListBoxItem x:Name="AppearanceTab" Content="{DynamicResource I18n.OverlayAppearanceTab}"/>
                  <ListBoxItem x:Name="WindowTab" Content="{DynamicResource I18n.OverlayWindowTab}"/>
                </ListBox>
              </DockPanel>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                <Grid MinHeight="164">
                  <StackPanel Visibility="{Binding IsSelected,ElementName=MetricsTab,Converter={StaticResource VisibleWhenTrue}}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <CheckBox x:Name="OverlayCurrent" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlayCurrentScore}"/>
                      <CheckBox x:Name="OverlayChange" Grid.Column="2" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlaySessionChange}"/>
                      <CheckBox x:Name="OverlayCount" Grid.Row="1" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlaySessionCount}"/>
                      <CheckBox x:Name="OverlayWinRate" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlaySessionWinRate}"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsSelected,ElementName=TrendTab,Converter={StaticResource VisibleWhenTrue}}">
                    <CheckBox x:Name="OverlayTrend" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlayShowTrend}"/>
                    <StackPanel Visibility="{Binding IsChecked,ElementName=OverlayTrend,Converter={StaticResource VisibleWhenTrue}}">
                      <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,6,0,0">
                        <StackPanel>
                          <DockPanel>
                            <TextBox x:Name="OverlayLimit" DockPanel.Dock="Right" Width="64" TextAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource I18n.OverlayMatchLimit}"/>
                            <TextBlock Text="{DynamicResource I18n.OverlayMatchLimit}" VerticalAlignment="Center"/>
                          </DockPanel>
                          <TextBlock x:Name="MatchLimitError" Style="{StaticResource Caption}" Foreground="{StaticResource Loss}" HorizontalAlignment="Right"
                                     Text="{DynamicResource I18n.OverlayLimitError}" Visibility="Collapsed" Margin="0,3,0,0"
                                     AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                      </Border>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DockPanel>
                          <TextBlock Text="{DynamicResource I18n.OverlayTrendPosition}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <ComboBox x:Name="TrendPosition" AutomationProperties.Name="{DynamicResource I18n.OverlayTrendPosition}">
                            <ComboBoxItem Content="{DynamicResource I18n.OverlayTrendRight}"/>
                            <ComboBoxItem Content="{DynamicResource I18n.OverlayTrendBelow}"/>
                          </ComboBox>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                          <TextBlock Text="{DynamicResource I18n.OverlayTrendSpacing}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <Slider x:Name="TrendSpacing" Minimum="0" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" TickFrequency="1"
                                  VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.OverlayTrendSpacing}"/>
                        </DockPanel>
                      </Grid>
                      <UniformGrid Columns="3" Margin="0,2,0,6">
                        <StackPanel Margin="0,0,5,0"><TextBlock Text="{DynamicResource I18n.OverlayWinColor}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                          <ComboBox x:Name="WinColor" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.OverlayWinColor}"/></StackPanel>
                        <StackPanel Margin="3,0"><TextBlock Text="{DynamicResource I18n.OverlayLossColor}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                          <ComboBox x:Name="LossColor" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.OverlayLossColor}"/></StackPanel>
                        <StackPanel Margin="5,0,0,0"><TextBlock Text="{DynamicResource I18n.OverlayLineColor}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                          <ComboBox x:Name="LineColor" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource I18n.OverlayLineColor}"/></StackPanel>
                      </UniformGrid>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <CheckBox x:Name="OverlayExtremes" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlayScoreExtremes}"/>
                        <CheckBox x:Name="OverlayPulse" Grid.Column="2" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlayHighlight}"/>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsSelected,ElementName=AppearanceTab,Converter={StaticResource VisibleWhenTrue}}">
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <CheckBox x:Name="OverlayGreen" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.StreamGreenScreen}"/>
                    </Grid>
                    <local:OverlayOpacityPicker x:Name="OverlayOpacity" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsSelected,ElementName=WindowTab,Converter={StaticResource VisibleWhenTrue}}">
                    <CheckBox x:Name="OverlayStartup" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OpenOverlayOnStartup}"/>
                    <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="0,4" Padding="0,4,0,0">
                      <CheckBox x:Name="OverlayTopmost" Style="{StaticResource LabeledSwitch}" Content="{DynamicResource I18n.OverlayAlwaysOnTop}"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Expander x:Name="OverlayCaptureHelp" Style="{StaticResource OverlayDisclosure}" Margin="0,10,0,0"
                    Header="{DynamicResource I18n.OverlayCaptureHelp}" AutomationProperties.Name="{DynamicResource I18n.OverlayCaptureHelp}">
            <TextBlock Text="{DynamicResource I18n.OverlayCaptureHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          </Expander>
        </StackPanel>

        <StackPanel x:Name="NetworkPage" Visibility="Hidden">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.UseProxy}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ProxyEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.UseProxy}"/>
              </Grid>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.ProxyAddress}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ProxyAddressBox" Grid.Column="1" IsEnabled="{Binding IsChecked,ElementName=ProxyEnabled}" ToolTip="{DynamicResource I18n.ProxyHelp}" AutomationProperties.Name="{DynamicResource I18n.ProxyAddress}"/>
                </Grid>
              </Border>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.GoogleLatency}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TestResult" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <Button x:Name="TestButton" Grid.Column="2" Content="{DynamicResource I18n.Test}" Click="Test_Click"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel Margin="16,12">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.ApiInterval}" VerticalAlignment="Center"/>
                <TextBox x:Name="ApiIntervalBox" Grid.Column="1" TextChanged="ApiInterval_Changed" MaxLength="8" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.ApiIntervalAccessible}" ToolTip="{DynamicResource I18n.ApiIntervalHelp}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                <ListBox x:Name="ApiIntervalPresets" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Left" SelectionChanged="ApiIntervalPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.ApiIntervalPresets}">
                  <ListBoxItem Content="{DynamicResource I18n.OneSecond}" Tag="1" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TwoSeconds}" Tag="2" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.FiveSeconds}" Tag="5" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TenSeconds}" Tag="10" Width="70" Padding="4,4"/>
                </ListBox>
              </Grid>
              <TextBlock x:Name="ApiIntervalWarning" Text="{DynamicResource I18n.ShortIntervalWarning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="160,6,0,0" FontSize="12" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="RefreshPage" Visibility="Hidden">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.RefreshReminder}" VerticalAlignment="Center"/>
                <TextBox x:Name="ReminderSecondsBox" Grid.Column="1" TextChanged="ReminderSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="{DynamicResource I18n.ReminderOffHelp}" AutomationProperties.Name="{DynamicResource I18n.ReminderAccessible}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                <ListBox x:Name="ReminderPresets" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Left" SelectionChanged="ReminderPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.ReminderPresets}">
                  <ListBoxItem Content="{DynamicResource I18n.Off}" Tag="0" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneDay}" Tag="86400" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TwelveHours}" Tag="43200" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneHour}" Tag="3600" Width="56" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TenMinutes}" Tag="600" Width="56" Padding="4,4"/>
                </ListBox>
              </Grid>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
                <Grid Margin="0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.AutoRefresh}" VerticalAlignment="Center"/>
                  <TextBox x:Name="AutoRefreshSecondsBox" Grid.Column="1" TextChanged="AutoRefreshSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="{DynamicResource I18n.AutoRefreshHelp}" AutomationProperties.Name="{DynamicResource I18n.AutoRefreshAccessible}"/>
                  <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                  <ListBox x:Name="AutoRefreshPresets" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Left" SelectionChanged="AutoRefreshPreset_Changed" AutomationProperties.Name="{DynamicResource I18n.AutoRefreshPresets}">
                    <ListBoxItem Content="{DynamicResource I18n.Off}" Tag="0" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.FiveMinutes}" Tag="300" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.TwentyMinutes}" Tag="1200" Width="70" Padding="4,4"/><ListBoxItem Content="{DynamicResource I18n.OneHour}" Tag="3600" Width="70" Padding="4,4"/>
                  </ListBox>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel Margin="16,10">
              <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.RefreshAfterMatchLabel}" VerticalAlignment="Center"/>
                <StackPanel x:Name="GameRunningStatus" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Text,ElementName=GameRunningHint}">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=RefreshAfterMatchEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Ellipse x:Name="GameRunningLight" Width="8" Height="8" Fill="Transparent" Stroke="{StaticResource Ink3}" StrokeThickness="1.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="GameRunningHint" Text="{DynamicResource I18n.Sf6NotRunning}" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="RefreshAfterMatchEnabled" Grid.Column="2" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.RefreshAfterMatchLabel}" ToolTip="{DynamicResource I18n.RefreshAfterMatchHelp}"/>
              </Grid>
              <Grid MinHeight="30" Margin="0,6,0,0" IsEnabled="{Binding IsChecked,ElementName=RefreshAfterMatchEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.FocusLatestMatch}" VerticalAlignment="Center"/>
                <CheckBox x:Name="FocusLatestMatchEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.FocusLatestMatch}" ToolTip="{DynamicResource I18n.FocusLatestMatchHelp}"/>
              </Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.MatchEndWait}" VerticalAlignment="Center"/>
                <TextBox x:Name="MatchEndWaitBox" Grid.Column="1" MaxLength="4" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.MatchEndWait}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </Grid>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.MatchEndRetry}" VerticalAlignment="Center"/>
                <TextBox x:Name="MatchEndRetryBox" Grid.Column="1" MaxLength="4" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.MatchEndRetry}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SecondsUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </Grid>
              <Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.MatchEndFrequency}" VerticalAlignment="Center"/>
                <TextBox x:Name="MatchEndFrequencyBox" Grid.Column="1" MaxLength="4" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource I18n.MatchEndFrequency}"/>
                <TextBlock Grid.Column="2" Text="{DynamicResource I18n.SamplesPerSecondUnit}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="DataPage" Visibility="Hidden">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource I18n.Database}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DatabaseStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button x:Name="ImportButton" Content="{DynamicResource I18n.Import}" Click="Import_Click" Margin="0,0,8,0" ToolTip="{DynamicResource I18n.ImportHelp}"/>
                  <Button x:Name="BackupButton" Content="{DynamicResource I18n.BackupDatabase}" Click="Backup_Click" ToolTip="{DynamicResource I18n.BackupHelp}"/>
                </StackPanel>
              </Grid>
              <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
                <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.Logs}" VerticalAlignment="Center"/>
                  <Button x:Name="OpenLogsButton" Grid.Column="2" Content="{DynamicResource I18n.OpenLogFolder}" Click="OpenLogs_Click" AutomationProperties.Name="{DynamicResource I18n.OpenLogFolder}"/>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="AboutPage" Visibility="Hidden">
          <Border Style="{StaticResource Card}">
            <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="{DynamicResource I18n.CurrentVersion}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Text="{x:Static core:GitHubUpdates.VersionLabel}" Style="{StaticResource Number}" Foreground="{StaticResource Ink2}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{DynamicResource I18n.CurrentVersion}" AutomationProperties.Name="{DynamicResource I18n.CurrentVersion}"/>
                <Button x:Name="GitHubButton" Content="GitHub ↗" Style="{StaticResource GhostButton}" Padding="6,6" Click="GitHub_Click" ToolTip="{x:Static core:GitHubUpdates.RepositoryUrl}" AutomationProperties.Name="{DynamicResource I18n.OpenGitHub}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CheckUpdatesButton" Content="{DynamicResource I18n.CheckUpdates}" Click="CheckUpdates_Click"/>
                <Border>
                  <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility,ElementName=AvailableUpdateNotice}" Value="Visible">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers></Style></Border.Style>
                  <Button x:Name="InstallUpdateButton" Content="{DynamicResource I18n.InstallUpdate}" Click="InstallUpdate_Click" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Visibility="Collapsed" ToolTip="{DynamicResource I18n.InstallUpdateHelp}"/>
                </Border>
              </StackPanel>
              <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource I18n.CheckForUpdatesOnStartup}" VerticalAlignment="Center"/>
                  <CheckBox x:Name="StartupUpdateEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.CheckForUpdatesOnStartup}"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Loss}" Margin="2,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="{DynamicResource I18n.Cancel}" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
        <Button x:Name="SaveButton" Content="{DynamicResource I18n.Save}" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="76"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Border>
    <local:StatusToast x:Name="UpdateToast" Grid.Row="1" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,70"/>
  </Grid>
</local:ChromeWindow>
