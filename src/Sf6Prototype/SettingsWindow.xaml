<Window x:Class="Sf6Prototype.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Icon="{StaticResource AppIcon}" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Display">
  <Border Background="{StaticResource Canvas}" Padding="24,20">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <Grid Margin="16,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="使用代理" VerticalAlignment="Center"/>
          <CheckBox x:Name="ProxyEnabled" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="使用代理"/>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="代理地址" VerticalAlignment="Center"/>
            <TextBox x:Name="ProxyAddressBox" Grid.Column="1" IsEnabled="{Binding IsChecked,ElementName=ProxyEnabled}" ToolTip="支持无认证 HTTP、HTTPS 和 SOCKS5 代理" AutomationProperties.Name="代理地址"/>
          </Grid>
        </Border>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Google 延迟" VerticalAlignment="Center"/>
            <TextBlock x:Name="TestResult" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button x:Name="TestButton" Grid.Column="2" Content="测试" Click="Test_Click"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Margin="16,12">
          <Grid MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="CAPCOM 请求间隔" VerticalAlignment="Center"/>
            <TextBox x:Name="ApiIntervalBox" Grid.Column="1" TextChanged="ApiInterval_Changed" MaxLength="8" VerticalContentAlignment="Center" AutomationProperties.Name="CAPCOM 请求间隔，单位秒" ToolTip="两次官网请求开始之间的最短间隔；数据和头像请求共用，登录网页与 Google 测试不受影响。"/>
            <TextBlock Grid.Column="2" Text="秒" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
            <ListBox x:Name="ApiIntervalPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ApiIntervalPreset_Changed" AutomationProperties.Name="CAPCOM 请求间隔预设">
              <ListBoxItem Content="1秒" Tag="1" Width="70" Padding="4,4"/><ListBoxItem Content="3秒" Tag="3" Width="70" Padding="4,4"/><ListBoxItem Content="5秒" Tag="5" Width="70" Padding="4,4"/><ListBoxItem Content="10秒" Tag="10" Width="70" Padding="4,4"/>
            </ListBox>
          </Grid>
          <TextBlock x:Name="ApiIntervalWarning" Text="间隔过短可能触发官网风控；建议至少 5 秒。" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="120,6,0,0" FontSize="12" Visibility="Collapsed"/>
        </StackPanel>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0"/>
        <Grid Margin="16,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="更新提醒" VerticalAlignment="Center"/>
          <TextBox x:Name="ReminderSecondsBox" Grid.Column="1" TextChanged="ReminderSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="0 表示不再晃动提醒" AutomationProperties.Name="更新提醒间隔，单位秒，0 关闭"/>
          <TextBlock Grid.Column="2" Text="秒" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
          <ListBox x:Name="ReminderPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ReminderPreset_Changed" AutomationProperties.Name="更新提醒快捷间隔">
            <ListBoxItem Content="关闭" Tag="0" Width="56" Padding="4,4"/><ListBoxItem Content="1天" Tag="86400" Width="56" Padding="4,4"/><ListBoxItem Content="12小时" Tag="43200" Width="56" Padding="4,4"/><ListBoxItem Content="1小时" Tag="3600" Width="56" Padding="4,4"/><ListBoxItem Content="10分钟" Tag="600" Width="56" Padding="4,4"/>
          </ListBox>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12" MinHeight="30"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="自动刷新" VerticalAlignment="Center"/>
            <TextBox x:Name="AutoRefreshSecondsBox" Grid.Column="1" TextChanged="AutoRefreshSeconds_Changed" MaxLength="10" VerticalContentAlignment="Center" ToolTip="0 表示关闭；仅刷新当前登录账号" AutomationProperties.Name="自动刷新间隔，单位秒，0 关闭"/>
            <TextBlock Grid.Column="2" Text="秒" Foreground="{StaticResource Ink3}" VerticalAlignment="Center" Margin="6,0,10,0"/>
            <ListBox x:Name="AutoRefreshPresets" Grid.Column="3" Style="{StaticResource Segmented}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="AutoRefreshPreset_Changed" AutomationProperties.Name="自动刷新快捷间隔">
              <ListBoxItem Content="关闭" Tag="0" Width="70" Padding="4,4"/><ListBoxItem Content="5分钟" Tag="300" Width="70" Padding="4,4"/><ListBoxItem Content="20分钟" Tag="1200" Width="70" Padding="4,4"/><ListBoxItem Content="1小时" Tag="3600" Width="70" Padding="4,4"/>
            </ListBox>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="关闭窗口时" VerticalAlignment="Center"/>
          <ComboBox x:Name="CloseActionBox" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="关闭窗口时">
            <ComboBoxItem Content="每次询问"/><ComboBoxItem Content="最小化到托盘"/><ComboBoxItem Content="退出"/>
          </ComboBox>
        </Grid>
        <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,1,0,0" Margin="16,0">
          <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="数据库" VerticalAlignment="Center"/>
            <TextBlock x:Name="DatabaseStatus" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Ink2}" TextWrapping="Wrap" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ImportButton" Content="导入" Click="Import_Click" Margin="0,0,8,0" ToolTip="合并战绩，保留现有记录"/>
              <Button x:Name="BackupButton" Content="备份数据库" Click="Backup_Click" ToolTip="包含战绩与分数，不包含登录信息、设置和头像"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Loss}" Margin="2,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
      <Button x:Name="SaveButton" Content="保存" IsDefault="True" Click="Save_Click" Style="{StaticResource AccentButton}" MinWidth="76"/>
    </StackPanel>
  </StackPanel>
  </Border>
</Window>
