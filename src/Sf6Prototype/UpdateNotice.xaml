<UserControl x:Class="Sf6Prototype.UpdateNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False" SnapsToDevicePixels="True"
             AutomationProperties.LiveSetting="Polite" AutomationProperties.LabeledBy="{Binding ElementName=MessageText}"
             AutomationProperties.HelpText="{Binding Text,ElementName=HintText}">
  <Border Style="{StaticResource Card}" CornerRadius="8" Padding="14,10,8,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SurfaceSelected}" VerticalAlignment="Center">
        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              Data="M 8,1 V 10 M 4.5,6.5 L 8,10 11.5,6.5 M 2,11 V 14 H 14 V 11"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
        <TextBlock x:Name="MessageText" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="HintText" Foreground="{DynamicResource Ink2}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="{DynamicResource I18n.InstallUpdateHelp}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="IgnoreUpdateButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Ink2}"
                Content="{DynamicResource I18n.IgnoreUpdate}" Padding="10,5" Click="Defer_Click"/>
        <Button x:Name="LaterButton" Content="{DynamicResource I18n.UpdateLater}" Margin="8,0,0,0" Padding="12,5" Click="Defer_Click"/>
        <Button x:Name="InstallPromptButton" Style="{StaticResource AccentButton}" Content="{DynamicResource I18n.InstallUpdate}"
                Margin="8,0,0,0" Padding="14,5" FontWeight="SemiBold" Click="Install_Click"/>
      </StackPanel>
      <Button x:Name="ClosePromptButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8BB;"
              Width="28" Height="28" MinHeight="0" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Top"
              Click="Close_Click" AutomationProperties.Name="{DynamicResource I18n.DismissNotice}" ToolTip="{DynamicResource I18n.DismissNotice}"/>
    </Grid>
  </Border>
</UserControl>
