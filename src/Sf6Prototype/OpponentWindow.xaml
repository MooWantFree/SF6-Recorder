<local:ChromeWindow x:Class="Sf6Prototype.OpponentWindow" Language="{DynamicResource UiLanguage}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sf6Prototype" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource I18n.RankHistory}" Icon="{StaticResource AppIcon}" Width="740" Height="580" MinWidth="660" MinHeight="380" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="56" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="24,8,16,0" VerticalAlignment="Center">
        <TextBlock x:Name="PlayerName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Button x:Name="UidButton" Click="CopyUid_Click" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Padding="6,3" MinHeight="24" Margin="-6,0,0,0" ToolTip="{DynamicResource I18n.Copy}" AutomationProperties.Name="{DynamicResource I18n.CopyPlayerUid}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="UidText" Style="{StaticResource Number}" Foreground="{StaticResource Ink2}"/><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource Ink3}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
      </StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource I18n.Refresh}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="RefreshLabel" Text="{DynamicResource I18n.Refresh}"/></StackPanel>
      </Button>
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{DynamicResource I18n.Minimize}" AutomationProperties.Name="{DynamicResource I18n.Minimize}"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{DynamicResource I18n.Close}" AutomationProperties.Name="{DynamicResource I18n.Close}"/>
      </StackPanel>
    </Grid>
  <Grid Grid.Row="1" Margin="24,12,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ComboBox x:Name="SeasonPicker" Width="140" SelectionChanged="Selection_Changed" DropDownOpened="Season_DropDownOpened" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource I18n.Season}"/>
      <ComboBox x:Name="ModePicker" Grid.Column="1" Width="130" SelectedIndex="0" SelectionChanged="Mode_Changed" AutomationProperties.Name="{DynamicResource I18n.QueryType}"><ComboBoxItem Content="{DynamicResource I18n.RankAndPoints}"/><ComboBoxItem Content="{DynamicResource I18n.PeakMr}"/></ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{DynamicResource I18n.IncludeUnranked}" Margin="0,0,8,0" VerticalAlignment="Center"/><CheckBox x:Name="ShowUnranked" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource I18n.IncludeUnranked}" Checked="Unranked_Changed" Unchecked="Unranked_Changed"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,2"><Grid>
      <DataGrid x:Name="RankGrid" RowHeight="46" SelectionMode="Single" AutomationProperties.Name="{DynamicResource I18n.PlayerCharacterRanks}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{DynamicResource I18n.Character}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><ContentControl Content="{Binding Image}" Style="{StaticResource Portrait}" Width="32" Height="32"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource I18n.RankLp}" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource Number}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Ink}"><Run Text="{Binding Rank.RankName,Mode=OneWay}" Foreground="{Binding Rank,Converter={StaticResource RankColor}}"/><Run Text="{Binding LpSuffix,Mode=OneWay}"/></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn x:Name="MrColumn" Header="MR" Binding="{Binding Rank.MrText}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock x:Name="EmptyText" Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      <StackPanel x:Name="LoadingState" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource I18n.LoadingCharacterRanks}">
        <ContentControl Style="{StaticResource LoadingSpinner}" Margin="0,0,8,0"/>
        <TextBlock Text="{DynamicResource I18n.Loading}" Foreground="{StaticResource Ink3}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid></Border>
    <TextBlock x:Name="Status" Grid.Row="2" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </Grid>
  </Grid>
</local:ChromeWindow>
