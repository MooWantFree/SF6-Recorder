<UserControl x:Class="Sf6Prototype.RecentMatchesStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sf6Prototype"
        Language="{DynamicResource UiLanguage}" FontFamily="{DynamicResource UiFont}" MinWidth="320" MinHeight="144"
        MouseLeftButtonDown="MoveWindow" FocusManager.FocusedElement="{Binding ElementName=Panel}">
  <Grid x:Name="Panel" Focusable="True" Resources="{StaticResource StreamPalette}">
    <local:OverlayMatchCard x:Name="Card"/>
    <ToggleButton x:Name="PinButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0" Style="{StaticResource OverlayPinButton}" Checked="Pin_Changed" Unchecked="Pin_Changed" Click="Pin_Click"
                  AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</UserControl>
