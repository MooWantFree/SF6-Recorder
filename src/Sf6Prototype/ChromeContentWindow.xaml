<local:ChromeWindow x:Class="Sf6Prototype.ChromeContentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sf6Prototype" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Language="{DynamicResource UiLanguage}" Icon="{StaticResource AppIcon}" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="56" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CaptionTitle" Text="{Binding Title,RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,16,0" TextTrimming="CharacterEllipsis"/>
      <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{DynamicResource I18n.Minimize}" AutomationProperties.Name="{DynamicResource I18n.Minimize}"/>
        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{DynamicResource I18n.Close}" AutomationProperties.Name="{DynamicResource I18n.Close}"/>
      </StackPanel>
    </Grid>
    <ContentControl x:Name="BodyHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
</local:ChromeWindow>
