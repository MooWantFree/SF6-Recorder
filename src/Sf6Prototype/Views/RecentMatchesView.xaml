<UserControl x:Class="Sf6Prototype.RecentMatchesView" Language="{DynamicResource UiLanguage}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sf6Prototype">
  <UserControl.Style>
    <Style TargetType="{x:Type local:RecentMatchesView}"><Setter Property="Height" Value="208"/>
      <Style.Triggers><Trigger Property="IsCollapsed" Value="True"><Setter Property="Height" Value="48"/></Trigger></Style.Triggers>
    </Style>
  </UserControl.Style>
  <Border Style="{StaticResource Card}" Padding="14,10,10,4">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Grid Margin="0,0,4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="RecentTitle" Text="{DynamicResource I18n.RecentMatches}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="CharacterName" Grid.Column="1" Foreground="{StaticResource Ink2}" TextTrimming="CharacterEllipsis" Margin="12,0" VerticalAlignment="Center"/>
        <ListBox x:Name="ScoreMetric" Grid.Column="2" Style="{StaticResource Segmented}" SelectedIndex="0" SelectionChanged="Metric_Changed" AutomationProperties.Name="{DynamicResource I18n.ScoreType}" FontSize="11" Margin="0,0,8,0">
          <ListBoxItem Content="LP" Padding="8,2"/><ListBoxItem Content="MR" Padding="8,2"/>
        </ListBox>
        <Button x:Name="CollapseButton" Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="0" Padding="0" FontSize="11" Content="&#xE70E;" Click="Collapse_Click"/>
      </Grid>
      <Grid x:Name="MetricsPanel" Grid.Row="1" Margin="0,0,4,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource I18n.HighestScore}" Style="{StaticResource Caption}"/><TextBlock x:Name="HighestScore" Text="—" Style="{StaticResource Number}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource I18n.LowestScore}" Style="{StaticResource Caption}"/><TextBlock x:Name="LowestScore" Text="—" Style="{StaticResource Number}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource I18n.RangeChange}" Style="{StaticResource Caption}"/><TextBlock x:Name="ScoreChange" Text="—" Style="{StaticResource Number}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource I18n.RangeWinRate}" Style="{StaticResource Caption}"/><TextBlock x:Name="ScoreWinRate" Text="—" Style="{StaticResource Number}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel>
      </Grid>
      <local:ScoreChart x:Name="Chart" Grid.Row="2" Compact="True" PointInvoked="Chart_PointInvoked" AutomationProperties.Name="{DynamicResource I18n.RecentMatches}" AutomationProperties.HelpText="{DynamicResource I18n.ChartHelp}"/>
    </Grid>
  </Border>
</UserControl>
